# Solo para correr el servicio a mano fuera de Docker.
#   cp .env.template .env

# Validado por Joi pero no se escucha en ningun puerto: products-ms habla solo NATS.
PORT=3000

# Faltaba en la version anterior de este template y es required(): sin esto el
# servicio muere al arrancar con "Invalid environment variables".
NATS_SERVERS=nats://localhost:4222

# SQLite, ruta relativa a la raiz del servicio. La lee tanto la app como el CLI de
# Prisma (generate / migrate), que la toma desde prisma.config.ts.
DATABASE_URL=file:./dev.db
